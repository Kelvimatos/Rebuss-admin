{
  "name": "rebuss-admin",
  "version": "1.0.0",
  "description": "REBUSS OPS - Plataforma Administrativa e Operacional",
  "main": "server/src/server.ts",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --ignore ./client/** --ignore ./.wwebjs_auth/** --ignore ./.wwebjs_cache/** --ignore ./uploads/** --ignore ./data/** server/src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "node server/src/scripts/generate-prisma.js && npm run build:client && tsc -p tsconfig.json && node server/src/scripts/sync-dist.js",
    "postinstall": "node server/src/scripts/generate-prisma.js",
    "build:client": "npm run build --prefix client",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:tsx": "tsx server/src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "seed:admin": "tsx server/src/scripts/bootstrap-admin.ts",
    "seed:teams": "tsx server/src/scripts/seed-sp-teams.ts && tsx server/src/scripts/seed-sjc-rj-teams.ts",
    "test": "tsx server/src/scripts/full-verification.ts",
    "test:scale-generator": "tsx server/src/scripts/test-scale-generator.ts",
    "test:auth-permissions": "tsx server/src/scripts/test-auth-permissions.ts",
    "test:security": "tsx server/src/scripts/test-appsec-hardening.ts",
    "bot": "node src/index.js",
    "bot:dev": "nodemon src/index.js",
    "test:bot": "node src/tests/bot.test.js"
  },
  "keywords": [
    "rebuss",
    "ops",
    "dashboard",
    "admin",
    "equipes-fixas"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.5",
    "multer": "^2.4.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
