{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me.js"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/logout.js"
    },
    {
      "source": "/api/auth/profile/:path*",
      "destination": "/api/auth/profile.js"
    },
    {
      "source": "/api/auth/profile",
      "destination": "/api/auth/profile.js"
    },
    {
      "source": "/uploads/avatars/:path*",
      "destination": "/api/auth/profile.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/dashboard/stats",
      "destination": "/api/dashboard/stats.js"
    },
    {
      "source": "/api/tools",
      "destination": "/api/tools.js"
    },
    {
      "source": "/api/fixed-teams/:path*",
      "destination": "/api/fixed-teams.js"
    },
    {
      "source": "/api/fixed-teams",
      "destination": "/api/fixed-teams.js"
    },
    {
      "source": "/api/users/:path*",
      "destination": "/api/users.js"
    },
    {
      "source": "/api/users",
      "destination": "/api/users.js"
    },
    {
      "source": "/api/scale-generator/locate",
      "destination": "/api/scale-generator/locate.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
