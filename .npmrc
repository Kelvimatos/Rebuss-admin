# ==============================================================================
# REBUSS OPS — CONFIGURAÇÃO DO NPM (.npmrc)
# ==============================================================================
# Configuração oficial do gerenciador de pacotes npm.
#
# NOTA DE APPSEC & DEVOPS:
# O npm oficial utiliza a chave de configuração 'cache' (ex: cache=~/.npm).
# O parâmetro 'cache-dir' é uma convenção exclusiva do Yarn/pnpm e gera o aviso
# [npm warn Unknown env config "cache-dir"] nas versões recentes do npm (v11+).
#
# Este arquivo garante conformidade com as diretrizes do npm e silencia conflitos.
# ==============================================================================

# Garante auditoria segura e mensagens informativas
audit=true
fund=false
save-exact=false

