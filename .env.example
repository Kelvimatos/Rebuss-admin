# ==============================================================================
# REBUSS OPS — ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# IMPORTANTE: Nunca versione o arquivo .env real no Git!
# Em produção, configure estas variáveis diretamente no painel da hospedagem.

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR BACKEND
# ------------------------------------------------------------------------------
# Modo de execução: "development" ou "production"
NODE_ENV="production"

# Porta onde o servidor Express responderá
PORT=3001

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / Supabase / Neon / Render / Railway)
# ------------------------------------------------------------------------------
# Formato padrão: postgresql://[USUARIO]:[SENHA]@[HOST]:[PORTA]/[NOME_BANCO]?sslmode=require
DATABASE_URL="postgresql://postgres:SENHA_SEGURA@localhost:5432/rebuss_ops"

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E AUTENTICAÇÃO (JWT & SESSÕES)
# ------------------------------------------------------------------------------
# Chave criptográfica para assinatura de tokens JWT (OBRIGATÓRIO: mínimo 32 caracteres)
# Gere uma chave segura executando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere_uma_chave_aleatoria_com_ao_menos_64_caracteres_hexadecimais"

# ------------------------------------------------------------------------------
# 4. POLÍTICA DE CORS E URLs AUTORIZADAS
# ------------------------------------------------------------------------------
# URL principal do frontend para redirecionamentos e CORS
FRONTEND_URL="https://rebuss-ops.onrender.com"

# Lista de origens autorizadas separadas por vírgula (em produção, apenas estas serão aceitas)
ALLOWED_ORIGINS="https://rebuss-ops.onrender.com,https://rebuss-ops.vercel.app"

# ------------------------------------------------------------------------------
# 5. CONTA ADMINISTRATIVA INICIAL (BOOTSTRAP IDEMPOTENTE)
# ------------------------------------------------------------------------------
# Utilizado pelo script npm run seed:admin para criar ou garantir a conta ADMIN
INITIAL_ADMIN_EMAIL="kelvimatosalves@gmail.com"
INITIAL_ADMIN_NAME="Kelvi Matos"

# ------------------------------------------------------------------------------
# 6. SERVIÇOS EXTERNOS (OPCIONAL / RESILIENTE)
# ------------------------------------------------------------------------------
# Chave da Google Maps Platform (Directions API, Geocoding API, Places API)
# Se não fornecida, o sistema utiliza o motor OpenStreetMap/Nominatim de alta precisão
GOOGLE_MAPS_API_KEY=""
