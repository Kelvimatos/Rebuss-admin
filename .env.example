# REBUSS OPS - Exemplo de Variáveis de Ambiente

# Conexão com o banco PostgreSQL local
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/rebuss_ops"

# Porta do servidor backend
PORT=3001

# Segredo para assinatura de tokens JWT e sessões (mínimo 32 caracteres)
JWT_SECRET="substitua_por_um_segredo_forte_e_seguro_com_ao_menos_32_caracteres"

# Ambiente de execução
NODE_ENV="development"

# URL do frontend para CORS
FRONTEND_URL="http://localhost:5173"

# Dados para o bootstrap inicial do administrador (executado via npm run seed:admin)
INITIAL_ADMIN_EMAIL="kelvimatosalves@gmail.com"
INITIAL_ADMIN_NAME="Administrador REBUSS"

